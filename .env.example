# Copy to .env at the repo root and fill in. Never commit .env.
# Every package reads this one file (apps/web loads it in next.config.ts;
# packages/db scripts load it with --env-file).

# --- Lead storage ----------------------------------------------------------------
# Which store the website writes enquiries to: auto (default) | supabase | postgres | memory
# auto = supabase if SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, else
# postgres if DATABASE_URL is set, else memory (development only; production
# without a database refuses submissions with a friendly error).
LEAD_STORE=auto

# Supabase project URL: Dashboard > Project Settings > Data API.
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key: SERVER-SIDE ONLY. Bypasses row level security. Never prefix
# with NEXT_PUBLIC_ and never import it from client code (the build checks).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by db:migrate / db:seed / db:types, and by
# the website when no service-role key is set. URL-encode special characters
# in the password (% -> %25, & -> %26). The direct host is IPv6-only on the
# Supabase free plan; from IPv4-only networks or serverless hosts use the
# Supavisor pooler URL instead (transaction mode, port 6543).
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Optional: run migrations over HTTPS through the Supabase Management API when
# raw Postgres connections are blocked (leave DATABASE_URL unset to use it).
# Create a token at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Optional: derived from SUPABASE_URL when unset.
SUPABASE_PROJECT_REF=

# Phase 2 (staff sign-in): public URL and anon key for the CRM's browser client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Email notifications (Resend) ------------------------------------------------
# Optional. Without it, new-lead emails are printed to the server console.
RESEND_API_KEY=
# Who receives new-lead notifications. Without a verified domain, Resend only
# delivers to the email address the Resend account was created with.
LEAD_NOTIFY_EMAIL=
# Sender. onboarding@resend.dev works without a verified domain.
EMAIL_FROM=onboarding@resend.dev

# --- Forms -------------------------------------------------------------------------
# Random secret used to hash client IPs for rate limiting (no raw IPs are stored).
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
RATE_LIMIT_SALT=

# --- Site ---------------------------------------------------------------------------
# Public base URL, used for metadata.
SITE_URL=http://localhost:3000
# The demo brand is kept out of search engines unless this is "true".
ALLOW_INDEXING=false
# Optional: stop Next.js sending anonymous build telemetry.
NEXT_TELEMETRY_DISABLED=1

# --- Tests ----------------------------------------------------------------------------
# Optional. Server for database integration tests (a temporary database is created
# and dropped). Without it, tests start a throwaway local cluster if Postgres is
# installed, or skip the database tests.
TEST_DATABASE_URL=
# Optional. Database for Playwright. Defaults to the local cluster from
# `pnpm db:local start` when it is running; otherwise an in-memory store is used.
E2E_DATABASE_URL=

# --- Phase 3: AI voice assistant (not used yet) ------------------------------------
GEMINI_API_KEY=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
