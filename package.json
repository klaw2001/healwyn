{
  "name": "healwyn",
  "private": true,
  "description": "Healwyn Clinics: demo lead-to-doctor platform (synthetic data only)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @healwyn/web dev",
    "build": "pnpm --filter @healwyn/web build",
    "start": "pnpm --filter @healwyn/web start",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @healwyn/web test:e2e",
    "lighthouse": "node scripts/lighthouse.mjs",
    "db:local": "bash scripts/local-db.sh",
    "db:migrate": "pnpm --filter @healwyn/db migrate",
    "db:seed": "pnpm --filter @healwyn/db seed",
    "db:types": "pnpm --filter @healwyn/db types",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
