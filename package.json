{
  "name": "healwyn",
  "private": true,
  "description": "Healwyn Clinics: demo lead-to-doctor platform (synthetic data only)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @healwyn/web dev",
    "build": "pnpm --filter @healwyn/web --filter @healwyn/crm build",
    "start": "pnpm --filter @healwyn/web start",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @healwyn/web test:e2e && pnpm --filter @healwyn/crm test:e2e",
    "lighthouse": "node scripts/lighthouse.mjs",
    "db:local": "bash scripts/local-db.sh",
    "db:migrate": "pnpm --filter @healwyn/db migrate",
    "db:seed": "pnpm --filter @healwyn/db seed",
    "db:types": "pnpm --filter @healwyn/db types",
    "check": "pnpm lint && pnpm lint:voice && pnpm typecheck && pnpm contracts:check && pnpm test && pnpm test:voice && pnpm build",
    "worker": "pnpm --filter @healwyn/messaging worker",
    "dev:crm": "pnpm --filter @healwyn/crm dev",
    "start:crm": "pnpm --filter @healwyn/crm start",
    "contracts": "bash scripts/voice.sh setup && pnpm --filter @healwyn/core contracts",
    "contracts:check": "bash scripts/voice.sh setup && pnpm --filter @healwyn/core contracts:check",
    "lint:voice": "bash scripts/voice.sh run sh -c \"ruff check . && ruff format --check .\"",
    "test:voice": "bash scripts/voice.sh run python -m pytest",
    "voice:setup": "bash scripts/voice.sh setup-agent",
    "voice:serve": "bash scripts/voice.sh run python -m healwyn_voice.server",
    "voice:agent": "bash scripts/voice.sh run python -m healwyn_voice.agent",
    "eval:voice": "bash scripts/voice.sh run python -m healwyn_voice.eval && prettier --write --log-level warn docs/VOICE_EVAL.md"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "globals": "^17.13.0",
    "lighthouse": "13.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
