{
  "name": "@healwyn/crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Staff and manager CRM",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build && node ../web/scripts/check-client-bundle.mjs .next/static",
    "start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@healwyn/core": "workspace:*",
    "@healwyn/db": "workspace:*",
    "@healwyn/messaging": "workspace:*",
    "@healwyn/ui": "workspace:*",
    "jose": "^6.2.12",
    "livekit-server-sdk": "2.19.1",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.4.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
