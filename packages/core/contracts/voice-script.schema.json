{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "packId": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "assistantName": {
      "type": "string"
    },
    "languages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "nativeLabel": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "label",
          "nativeLabel"
        ],
        "additionalProperties": false
      }
    },
    "greeting": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "consentQuestion": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "consentDeclined": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "goodbye": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "limitReached": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "questions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "select",
              "radio",
              "text",
              "textarea"
            ],
            "title": "QuestionKind"
          },
          "required": {
            "type": "boolean"
          },
          "prompt": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "maxLength": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "confirm": {
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "synonyms": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "required": [
                "value",
                "label",
                "synonyms"
              ],
              "additionalProperties": false,
              "title": "VoiceOption"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "required",
          "prompt",
          "maxLength",
          "confirm",
          "options"
        ],
        "additionalProperties": false,
        "title": "VoiceQuestion"
      }
    },
    "offeringQuestionId": {
      "type": "string"
    },
    "offeringUnsureValue": {
      "type": "string"
    },
    "messageQuestionId": {
      "type": "string"
    },
    "billingRule": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "questionId": {
              "type": "string"
            },
            "equals": {
              "type": "string"
            }
          },
          "required": [
            "questionId",
            "equals"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "reprompts": {
      "type": "object",
      "properties": {
        "unclear": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "moveOn": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "offTopic": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "unclear",
        "moveOn",
        "skipped",
        "offTopic"
      ],
      "additionalProperties": false
    },
    "confirm": {
      "type": "object",
      "properties": {
        "ask": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "fix": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "ask",
        "fix"
      ],
      "additionalProperties": false
    },
    "closing": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "callback": {
      "type": "object",
      "properties": {
        "questionId": {
          "type": "string"
        },
        "phrases": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "fallback": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "questionId",
        "phrases",
        "fallback"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "phrases": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "reply": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "phrases",
        "reply"
      ],
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "properties": {
        "emergencyNumber": {
          "type": "string"
        },
        "emergencyMessage": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "redFlags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_.:-]{1,64}$"
              },
              "label": {
                "type": "string"
              },
              "phrases": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "id",
              "label",
              "phrases"
            ],
            "additionalProperties": false,
            "title": "RedFlag"
          }
        },
        "negations": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "adviceRequests": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "adviceCues": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "adviceTopics": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "adviceDecline": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "injection": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "injectionReply": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "highUrgency": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "emergencyNumber",
        "emergencyMessage",
        "redFlags",
        "negations",
        "adviceRequests",
        "adviceCues",
        "adviceTopics",
        "adviceDecline",
        "injection",
        "injectionReply",
        "highUrgency"
      ],
      "additionalProperties": false
    },
    "yes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "no": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "skip": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "hangup": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxCallSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTurns": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxCallsPerDay": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "callWindow": {
          "type": "object",
          "properties": {
            "startHour": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "endHour": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "timeZone": {
              "type": "string"
            }
          },
          "required": [
            "startHour",
            "endHour",
            "timeZone"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "maxCallSeconds",
        "maxTurns",
        "maxCallsPerDay",
        "callWindow"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "packId",
    "brand",
    "assistantName",
    "languages",
    "greeting",
    "consentQuestion",
    "consentDeclined",
    "goodbye",
    "limitReached",
    "questions",
    "offeringQuestionId",
    "offeringUnsureValue",
    "messageQuestionId",
    "billingRule",
    "reprompts",
    "confirm",
    "closing",
    "callback",
    "identity",
    "safety",
    "yes",
    "no",
    "skip",
    "hangup",
    "summary",
    "limits"
  ],
  "additionalProperties": false,
  "title": "VoiceScript",
  "description": "Everything the voice agent says and listens for, built from an industry pack."
}
